\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Visão geral do método.} O sombreamento (laranja) calcula, em PyTorch, uma cor $\mathbf  {c}_i$ por Gaussiana e por vista a partir dos atributos de material e de um mapa de ambiente aprendido. Essa cor entra no rasterizador do GOF pelo caminho de cor pré-computada, que já existia e já devolvia $\partial \mathcal  {L}/\partial \mathbf  {c}_i$; o restante do gradiente é obtido por diferenciação automática. Rasterizador, perdas geométricas e extração de malha são os do GOF, sem modificação.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{6}{\textbf {Visão geral do método.} O sombreamento (laranja) calcula, em PyTorch, uma cor $\bc _i$ por Gaussiana e por vista a partir dos atributos de material e de um mapa de ambiente aprendido. Essa cor entra no rasterizador do GOF pelo caminho de cor pré-computada, que já existia e já devolvia $\partial \mathcal {L}/\partial \bc _i$; o restante do gradiente é obtido por diferenciação automática. Rasterizador, perdas geométricas e extração de malha são os do GOF, sem modificação}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Função de sombreamento}{6}{subsection.3.2}\protected@file@percent }
\newlabel{eq:sombreamento}{{2}{6}{Função de sombreamento}{equation.2}{}}
